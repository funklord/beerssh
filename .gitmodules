[submodule "vterm"]
	path = vterm
	url = https://github.com/neovim/libvterm
[submodule "softkeys"]
	path = softkeys
	url = https://github.com/funklord/softkeys
[submodule "libssh"]
	path = libssh
	url = https://gitlab.com/libssh/libssh-mirror.git
[submodule "snurra"]
	path = snurra
	url = https://github.com/funklord/snurra
[submodule "fuzznet"]
	path = fuzznet
	url = https://github.com/funklord/fuzznet
	shallow = true
[submodule "monocypher"]
	path = monocypher
	url = https://github.com/LoupVaillant/Monocypher.git
[submodule "flog"]
	path = flog
	url = https://github.com/funklord/flog.git
