+/* Push row `row` of a `cols`-wide buffer, which during a resize is not
+ * the screen's own: sb_pushline_from_row reads the screen, and a buffer
+ * with the scrollback's rows prepended has rows the screen does not. */
+static void sb_pushline_from_buffer(VTermScreen *screen, const ScreenCell *buffer, int row, int cols, bool continuation)
+{
+  VTermScreenCell *cells = NULL;
+
+  if(!screen->pushline_without_cells) {
+    for(int col = 0; col < cols; col++)
+      screencell_to_cell(screen, &buffer[row * cols + col],
+          col + 1 < cols ? &buffer[row * cols + col + 1] : NULL, &screen->sb_buffer[col]);
+    cells = screen->sb_buffer;
+  }
+
+  if(screen->callbacks_has_pushline4 && screen->callbacks->sb_pushline4)
+    (screen->callbacks->sb_pushline4)(cols, cells, continuation, screen->cbdata);
+  else
+    (screen->callbacks->sb_pushline)(cols, cells, screen->cbdata);
