 /* How many cells are non-blank
  * Returns the position of the first blank cell in the trailing blank end */
+/* How many of a reflowed line's cells go on its next row, from `offset`
+ * of `width`: as many as fit, less one where the last would be the first
+ * half of a double-width glyph, which then starts the row after instead.
+ * Cut there, its halves landed on two rows -- the first drawn one cell
+ * wide in the last column, the second a blank starting the next.
+ * `cells` holds the line's cells as positions in `buffer`. */
+static int reflow_take(const ScreenCell *buffer, const int *cells, int offset, int width, int new_cols)
+{
+  int take = width - offset < new_cols ? width - offset : new_cols;
+  if(take == new_cols && take > 1 && offset + take < width &&
+      buffer[cells[offset + take]].chars[0] == (uint32_t)-1)
+    take--;
+  return take;
+}
