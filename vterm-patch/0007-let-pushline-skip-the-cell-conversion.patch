+   * row for nothing. NULL rather than a stale buffer, so a callback that
+   * reads anyway fails at once instead of copying the previous row. */
+  if(!screen->pushline_without_cells) {
+    VTermPos pos = { .row = row };
+    for(pos.col = 0; pos.col < screen->cols; pos.col++)
+      vterm_screen_get_cell(screen, pos, screen->sb_buffer + pos.col);
+    cells = screen->sb_buffer;
