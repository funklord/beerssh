-    (screen->callbacks->sb_pushline4)(screen->cols, screen->sb_buffer, continuation, screen->cbdata);
+    (screen->callbacks->sb_pushline4)(screen->cols, cells, continuation, screen->cbdata);
   else
-    (screen->callbacks->sb_pushline)(screen->cols, screen->sb_buffer, screen->cbdata);
+    (screen->callbacks->sb_pushline)(screen->cols, cells, screen->cbdata);
 }
 
