+/* Vertical motion stops at a margin the cursor has not passed, in origin
+ * mode or not, and a cursor past one has only the screen's edge left. */
+static void cursor_down(VTermState *state, int count)
+{
+  const int bottom = SCROLLREGION_BOTTOM(state) - 1;
+  const int limit = state->pos.row > bottom ? state->rows - 1 : bottom;
+  state->pos.row = count > limit - state->pos.row ? limit : state->pos.row + count;
+}
+
+static void cursor_up(VTermState *state, int count)
+{
+  const int top = state->scrollregion_top;
+  const int limit = state->pos.row < top ? 0 : top;
+  state->pos.row = count > state->pos.row - limit ? limit : state->pos.row - count;
+}
+
+/* ICH and DCH work on the cursor's row whatever the top and bottom margins
+ * say; only the left and right ones bound them. */
+static int is_cursor_in_columns(const VTermState *state)
+{
+  return state->pos.col >= SCROLLREGION_LEFT(state) &&
+         state->pos.col < SCROLLREGION_RIGHT(state);
+}
