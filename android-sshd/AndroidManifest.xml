<?xml version="1.0"?>
<!--
	AndroidManifest.xml for beersshd (project.md sec 19)

	A separate app from BeerSSH, with its own id, so that the permission
	to reach shared storage belongs to the program whose whole purpose is
	serving it. Shaped like android/AndroidManifest.xml, which says why
	each part of Qt's template is kept; this one keeps the same parts and
	says only where it differs.

	XML forbids a double hyphen inside a comment, so nothing here uses
	one as a dash.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="se.vibes.beersshd"
          android:installLocation="auto"
          android:versionCode="-- %%INSERT_VERSION_CODE%% --"
          android:versionName="-- %%INSERT_VERSION_NAME%% --">

	<!--
		%%INSERT_PERMISSIONS is absent for BeerSSH's reason: the permission
		list is this file's to own. Qt6Core would add READ and
		WRITE_EXTERNAL_STORAGE, which do nothing on the Android versions
		this runs on (minSdk 30); MANAGE_EXTERNAL_STORAGE below is what
		reaches shared storage there.
	-->
	<!-- %%INSERT_FEATURES -->

	<uses-permission android:name="android.permission.INTERNET"/>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

	<!--
		"All files access": shared storage, which is what this app serves.
		Not a runtime prompt; the user turns it on in Settings, from a
		screen the app opens and explains. Play allows it to apps whose
		core purpose needs it, and a file server's does (sec 19).
	-->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>

	<!--
		The foreground service while the server listens. connectedDevice,
		BeerSSH's type and for a stronger reason: Android's definition and
		Play's both name data transfer to a device over a network
		connection, which is a computer pulling files over the LAN, and it
		has no runtime limit. dataSync was the first choice and is wrong
		for a server that must stay reachable: six hours in twenty-four on
		Android 15, and Play's 2027 policy keeps it for user-initiated
		transfers, naming the scheduled backup as what it is not for
		(sec 19.7). CHANGE_NETWORK_STATE is the qualifying permission
		connectedDevice asks for, as in BeerSSH.
	-->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
	<uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

	<!-- For SshdBoot: a restart with the server on says so (sec 19.6). -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

	<supports-screens
	        android:anyDensity="true"
	        android:largeScreens="true"
	        android:normalScreens="true"
	        android:smallScreens="true" />

	<!--
		allowBackup false: the app's own directory holds the host key, and
		a backup would copy a private key to the user's cloud account.
	-->
	<application android:name="org.qtproject.qt.android.bindings.QtApplication"
	             android:label="beersshd"
	             android:hardwareAccelerated="true"
	             android:enableOnBackInvokedCallback="false"
	             android:allowBackup="false"
	             android:fullBackupOnly="false">

		<activity android:name="org.qtproject.qt.android.bindings.QtActivity"
		          android:label="beersshd"
		          android:exported="true"
		          android:launchMode="singleTop"
		          android:screenOrientation="unspecified"
		          android:windowSoftInputMode="adjustResize"
		          android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density">

			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>

			<meta-data android:name="android.app.lib_name"
			           android:value="-- %%INSERT_APP_LIB_NAME%% --"/>
			<meta-data android:name="android.app.arguments"
			           android:value="-- %%INSERT_APP_ARGUMENTS%% --"/>

			<!--
				Qt's thread runs in the background, as in BeerSSH and for
				the same reason (its manifest says why): the window's Wi-Fi
				poll lives there, and without this it stops at onStop, so a
				new address while the app is away was followed only once
				it was reopened (sec 19.6).
			-->
			<meta-data android:name="android.app.background_running"
			           android:value="true"/>
		</activity>

		<receiver android:name="se.vibes.beersshd.SshdBoot"
		          android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED"/>
			</intent-filter>
		</receiver>

		<!--
			The server, in a process of its own (sec 19.6). As a QtService it
			loads Qt there and runs main with the arguments below, which
			serve with no window; the app's window starts and stops it and
			reads what it writes. Its own process because a Qt a service
			started in the app's process makes the activity restart that
			whole process when it opens, and the server has to come up at
			boot, before any activity. background_running for the reason
			the activity has it: Qt otherwise stops this process's event
			loop, and the Wi-Fi poll with it, since a service is never in
			front.
		-->
		<service android:name="se.vibes.beersshd.SshdService"
		         android:exported="false"
		         android:process=":server"
		         android:foregroundServiceType="connectedDevice">
			<meta-data android:name="android.app.lib_name"
			           android:value="-- %%INSERT_APP_LIB_NAME%% --"/>
			<meta-data android:name="android.app.arguments"
			           android:value="--serve"/>
			<meta-data android:name="android.app.background_running"
			           android:value="true"/>
		</service>

		<provider android:name="androidx.core.content.FileProvider"
		          android:authorities="${applicationId}.qtprovider"
		          android:exported="false"
		          android:grantUriPermissions="true">
			<meta-data android:name="android.support.FILE_PROVIDER_PATHS"
			           android:resource="@xml/qtprovider_paths"/>
		</provider>
	</application>
</manifest>
