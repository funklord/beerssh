#!/bin/sh
# Refuse to push what check-ci has not passed (project.md sec 12.4).
#
# This one is beerssh's own -- it is NOT one of the files spread from
# ~/.claude/tools, because what it runs, `make check-ci`, is this project's
# script against this project's workflow. It lives in the tree for the same
# reasons commit-msg does: the copy that runs is in .git/hooks, which is
# untracked, so a hook that exists only there enforces a rule nobody can
# see, does not survive a clone, and cannot be diffed. `make hooks`
# installs it.
#
# Why a hook rather than a habit. The habit existed and worked, for the one
# session that had it: everything it pushed was gated, and a commit pushed
# by a second session working in the same tree was not. A rule kept in a
# person's head binds that person, and these trees routinely have more than
# one worker in them. The gate had to be in the repository to be the
# repository's.
#
# Bypass with `git push --no-verify`, which is at least a decision rather
# than an accident.

set -eu

cd "$(git rev-parse --show-toplevel)"

head_sha=$(git rev-parse HEAD)
stamp="$(git rev-parse --git-dir)/check-ci-passed"

# git feeds a pre-push hook one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
# An all-zero local sha is a deletion, which builds nothing and is not this
# hook's business.
pushing=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "$local_sha" in
		"" | *[!0]*) ;;
		*) continue ;;
	esac
	[ -n "$local_sha" ] && pushing="$pushing $local_sha"
done

[ -n "$pushing" ] || exit 0

# check-ci stages with `git archive HEAD`, so HEAD is the only commit it can
# report on. Gating a push of some other commit would run the check against
# the wrong tree and pass, which is worse than not checking: it would put a
# green result against sources nobody built.
for sha in $pushing; do
	if [ "$sha" != "$head_sha" ]; then
		echo "pre-push: refusing -- $(git rev-parse --short "$sha") is not HEAD." >&2
		echo "pre-push:   check-ci stages with \`git archive HEAD\`, so it can only" >&2
		echo "pre-push:   report on HEAD. Check that commit out and push from" >&2
		echo "pre-push:   there, or bypass with --no-verify." >&2
		exit 1
	fi
done

# This hook CHECKS the receipt. It does not run the check, and that is the
# whole design rather than an economy.
#
# It used to run `make check-ci` here, and doing so broke the push it was
# guarding. git opens the connection to the remote BEFORE running pre-push
# and sends the pack afterwards, so five minutes of hook left an idle
# socket that the far end closed: the push died with SIGPIPE having just
# printed that the check passed. Twice, and the second time it reported
# success while landing nothing.
#
# Measured against the alternatives rather than guessed. The same hook and
# the same full run push cleanly to a local bare repo, twice, so the check
# breaks nothing; and a stamped push wrapped in `timeout` succeeds, so the
# wrapper was not it either. What the two failures had in common was a
# remote reached over the network.
#
# So the slow work lives outside, and tools/check-ci.sh writes the receipt
# when it passes. Nothing here takes longer than reading a file, and the
# connection is never left idle.
#
# Absent docker needs no special case now: check-ci refuses to run without
# it, so no receipt is written and this refuses in turn.
if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$head_sha" ]; then
	echo "pre-push: check-ci passed for $(git rev-parse --short HEAD)"
	exit 0
fi

echo "pre-push: refusing -- check-ci has not passed for $(git rev-parse --short HEAD)." >&2
echo "pre-push:   Run it, then push:" >&2
echo "pre-push:     make check-ci && git push" >&2
echo "pre-push:   It builds and tests in the runner's image, whose Qt and libssh" >&2
echo "pre-push:   are older than this machine's, and writes the receipt this hook" >&2
echo "pre-push:   reads. Bypass with --no-verify if you mean to." >&2
exit 1
