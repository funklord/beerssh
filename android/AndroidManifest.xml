<?xml version="1.0"?>
<!--
	AndroidManifest.xml for BeerSSH (project.md sec 0.1, sec 2)

	Hand-maintained rather than left to androiddeployqt's default, because
	the default ships the app as org.qtproject.example rather than
	se.vibes.beerssh.

	Reconciled against the template in the installed kit
	(Qt/6.11.1/android_arm64_v8a/src/android/templates/AndroidManifest.xml)
	after the first Android build. The %%INSERT...%% tokens are substituted
	by androiddeployqt and must survive verbatim; the first version of this
	file hardcoded values where tokens belong, which would have silently
	ignored the versions set in beerssh.pro.

	NOTE ON COMMENTS: XML forbids a double hyphen inside a comment, so the
	house style of using one as an em dash cannot be used in this file.
	The first version of this manifest did, and was therefore malformed
	from the day it was written; nothing noticed until it was parsed,
	because nothing parses a manifest until packaging.

	Where this deviates from Qt's template it is deliberate, and each
	deviation says why. Everything else follows the template, because the
	parts that look like boilerplate are the parts androiddeployqt and
	Qt's own Java layer depend on.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="se.vibes.beerssh"
          android:installLocation="auto"
          android:versionCode="-- %%INSERT_VERSION_CODE%% --"
          android:versionName="-- %%INSERT_VERSION_NAME%% --">

	<!--
		The %%INSERT_PERMISSIONS marker is deliberately absent. With it,
		androiddeployqt injects whatever Qt's own module manifests ask
		for, and Qt6Core's asks for READ and WRITE_EXTERNAL_STORAGE. That
		is an SSH client requesting access to the user's photos and
		documents, which sec 13 says to avoid and Play review asks about.
		Nothing here reads external storage: profiles, known hosts and
		credentials all live in the app's own directory.

		The cost of removing the marker is that a permission Qt genuinely
		needs would have to be added here by hand. That is the right way
		round: the permission list is a thing this project should own
		rather than inherit.

		%%INSERT_FEATURES stays, because uses-feature entries drive Play
		device filtering and Qt knows what it needs (OpenGL ES) better
		than this file does.
	-->
	<!-- %%INSERT_FEATURES -->

	<uses-permission android:name="android.permission.INTERNET"/>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

	<!--
		The foreground service (sec 5.1). connectedDevice is the type this
		project starts with: no runtime time limit, unlike dataSync, whose
		Android 15 cap of roughly six hours a day is a poor fit for a shell
		left open all day. It requires one of a set of qualifying
		permissions, which is what CHANGE_NETWORK_STATE is doing here.

		sec 5.1 keeps specialUse as the fallback if Play pushes back on
		the framing, and says to re-check the policy at build time because
		these rules move.
	-->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
	<uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

	<!--
	  The biometric prompt that gates releasing a stored password
	  (project.md sec 11). Not dangerous and not runtime-requested: the
	  system grants it at install and the prompt itself is the consent.
	  The feature is per host and off by default, and absent entirely
	  where nothing is enrolled.
	-->
	<uses-permission android:name="android.permission.USE_BIOMETRIC"/>

	<supports-screens
	        android:anyDensity="true"
	        android:largeScreens="true"
	        android:normalScreens="true"
	        android:smallScreens="true" />

	<!--
		allowBackup is false, a deliberate deviation from Qt's template,
		which says true. This app's data directory holds the known-hosts
		store and, where no keyring is running, the encrypted credential
		file (sec 11). Android's automatic backup would copy both to the
		user's cloud account, which is not a decision a terminal should
		make on their behalf.
	-->
	<application android:name="org.qtproject.qt.android.bindings.QtApplication"
	             android:label="BeerSSH"
	             android:icon="-- %%INSERT_APP_ICON%% --"
	             android:hardwareAccelerated="true"
	             android:enableOnBackInvokedCallback="false"
	             android:allowBackup="false"
	             android:fullBackupOnly="false">

		<!--
			configChanges is load-bearing, not boilerplate: handling these
			in-process rather than letting Android recreate the activity is
			what stops a rotation or a fold tearing down the view tree
			under live sessions (sec 8.2).

			windowSoftInputMode is ours, not the template's: without
			adjustResize the soft keyboard covers the terminal and the
			on-screen key row instead of shrinking the grid above it
			(sec 6.2).
		-->
		<activity android:name="org.qtproject.qt.android.bindings.QtActivity"
		          android:label="BeerSSH"
		          android:exported="true"
		          android:launchMode="singleTop"
		          android:screenOrientation="unspecified"
		          android:windowSoftInputMode="adjustResize"
		          android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density">

			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>

			<!--
				Opening a preset file (sec 10.5). This is the direction
				that works on Android: choosing a file from inside the
				app through the document picker does not, while being
				handed one does, and being handed one is the gesture the
				platform is built around.

				Deliberately narrow. A filter claiming every text/plain
				document would put BeerSSH in the "open with" list of
				every note and log on the device, which is rude and
				would also be a lie: the only file this app can open is
				a preset. The pathPattern restricts it to names ending
				in .ini, and the host wildcard is required for a
				pathPattern to be considered at all.
			-->
			<intent-filter>
				<action android:name="android.intent.action.VIEW"/>
				<category android:name="android.intent.category.DEFAULT"/>
				<category android:name="android.intent.category.BROWSABLE"/>
				<data android:scheme="file"/>
				<data android:scheme="content"/>
				<data android:host="*"/>
				<data android:mimeType="application/octet-stream"/>
				<data android:pathPattern=".*\\.ini"/>
			</intent-filter>

			<!--
				Sharing a preset to BeerSSH, which is what a file manager
				offers when a document has no obvious owner.
			-->
			<intent-filter>
				<action android:name="android.intent.action.SEND"/>
				<category android:name="android.intent.category.DEFAULT"/>
				<data android:mimeType="application/octet-stream"/>
			</intent-filter>

			<meta-data android:name="android.app.lib_name"
			           android:value="-- %%INSERT_APP_LIB_NAME%% --"/>
			<meta-data android:name="android.app.arguments"
			           android:value="-- %%INSERT_APP_ARGUMENTS%% --"/>
		</activity>

		<!--
			Required by Qt 6.11's Android layer, and absent from the first
			version of this file because that was written from memory of
			an older Qt. Qt uses it for content URIs; leaving it out is the
			kind of omission that surfaces as a crash the first time a file
			dialog opens rather than as a build error.
		-->
		<!--
			Not exported: nothing outside this app has any business
			starting it, and an exported service is a component any other
			app can poke.
		-->
		<service android:name="se.vibes.beerssh.BsshService"
		         android:exported="false"
		         android:foregroundServiceType="connectedDevice"/>

		<provider android:name="androidx.core.content.FileProvider"
		          android:authorities="${applicationId}.qtprovider"
		          android:exported="false"
		          android:grantUriPermissions="true">
			<meta-data android:name="android.support.FILE_PROVIDER_PATHS"
			           android:resource="@xml/qtprovider_paths"/>
		</provider>
	</application>
</manifest>
