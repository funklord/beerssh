<?xml version="1.0" encoding="UTF-8"?>
<!--
	AppStream metadata (project.md sec 12.2). Without this the app is
	invisible to software centres, which is where most people on a Linux
	desktop look for anything.

	The id, the launchable and the .desktop file's basename must all agree
	with sec 0.1's app id; a mismatch shows up as an application that
	installs, runs, and cannot be found.
-->
<component type="desktop-application">
  <id>se.vibes.beerssh</id>

  <name>BeerSSH</name>

  <!--
       Who wrote it, which appstreamcli asks for and harmonization.md
       already requires on the surfaces a reader looks at: the version
       output, the About window, the README. A software centre is one of
       those.

       No <url type="homepage">: the repository is private today, so a
       homepage here would send a user to a 404. The absence is correct
       rather than missing, and it is the one thing appstreamcli warns
       about that cannot be honestly answered yet.
  -->
  <developer id="se.vibes">
    <name>Nabeel Sowan</name>
  </developer>
  <summary>SSH terminal for desktop and Android</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <!-- No <project_license>: this tree carries no licence, deliberately,
       from 2026-08-31. An SPDX expression here would assert terms that
       have not been chosen, and LicenseRef-proprietary would assert a
       different set. The field returns when the holder settles them. -->

  <description>
    <p>
      An SSH client with a real terminal emulator, built from one codebase for
      the desktop and for Android. Sessions live independently of the windows
      showing them, so tabs, split panes and a phone rotating do not disturb a
      connection.
    </p>
    <p>Features:</p>
    <ul>
      <li>True-colour terminal emulation with images (sixel, kitty, iTerm2)</li>
      <li>Tabs everywhere, split panes where the window is wide enough</li>
      <li>Host presets that many hosts share, with per-host overrides</li>
      <li>A curated set of terminal fonts and colour schemes</li>
      <li>Reconnection with backoff, and keepalive for hostile networks</li>
    </ul>
  </description>

  <launchable type="desktop-id">se.vibes.beerssh.desktop</launchable>

  <provides>
    <binary>beerssh</binary>
  </provides>

  <categories>
    <category>Network</category>
    <category>TerminalEmulator</category>
  </categories>

  <content_rating type="oars-1.1"/>
</component>
