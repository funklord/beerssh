// The session protocol's frames (project.md sec 5.6): what the session host
// and its client say to each other, on any transport that carries bytes in
// order. A frame is a type, a length and a body, so a side that does not know
// a type skips the length and carries on.
//
// Offsets are the raw log's, counted from the start of the session.

target buffer;
endian big;

varint_type bssh_varint {
	encoding = leb128;
	max_bits = 64;
	minimal;
}

// Kinds, as a plain byte and not an enum: situ refuses a value an enum does not
// name, and a side must be able to skip a kind only a newer side knows.
//   1 attach   client: send from this offset, at this size
//   2 output   host: raw bytes from this offset
//   3 input    client: bytes for the program
//   4 ack      client: I hold everything below this offset
//   5 resize   client: the terminal's size
//   6 exited   host: the program ended
//   7 lost     host: nothing older than this offset is held, and how many
//              lines the session had written before it
//   8 mode     client: live, eventual or serial
//   9 hello    host: the first bytes on every link, a fixed text
//  10 restarted host: not the session asked for; a new one, from this offset
//  11 hangup   client: the user closed it, end the program
//  12 caught_up host: what was written before this attach has all been sent
//  13 keyframes client: this client takes 14 to 16 in place of 7 and a replay
//  14 keyframe host: what follows replaces the screen, the history first
//  15 history  host: one line that scrolled off the top, by number
//  16 repaint  host: part of the screen as a terminal draws it, standing for
//              everything before an offset

struct bssh_frame {
	u8           kind;
	bssh_varint  length [max = 65536];
	u8           body[length];
}

struct bssh_frame_attach {
	bssh_varint  offset;
	u16          columns;
	u16          rows;
}

struct bssh_frame_resize {
	u16  columns;
	u16  rows;
}

struct bssh_frame_offset {
	bssh_varint  offset;
}

struct bssh_frame_lost {
	bssh_varint  offset;
	bssh_varint  lines;
}

struct bssh_frame_exited {
	i32  status;
}

struct bssh_frame_mode {
	u8  mode [max = 2];  // 0 live, 1 eventual, 2 serial
}

// What was lost is not replayed from the oldest byte held, which would draw
// onto a screen that is not the one those bytes were written for. The client
// is sent the lines it lacks, from `from`, and then the screen as it is now.
// `lost` says that lines before `from` went past the server's limit as well,
// how many being unknown.
struct bssh_frame_keyframe {
	bssh_varint  from;
	u8           lost [max = 1];
}

// A history line's number and whether it continues the line above. The rest
// of the body is the line's cells, as runs in one style:
//   u8 attributes (BSSH_SCREEN_BOLD and the rest; the top bit is zero)
//   colour foreground, colour background: u8 kind, then nothing for the
//     default, one byte for a palette index, three for red, green and blue
//   varint count, at least one
//   count varints: a character shifted left one, the low bit set when it is
//     two cells wide; 0 for a cell never written
// The far half of a wide character is not sent: the width says it is there.
struct bssh_frame_history {
	bssh_varint  number;
	u8           continuation [max = 1];
}

// The rest of the body is repaint bytes, fed to the client's emulator as they
// come. The last part says so, and the client then stands at `offset`, with
// `lines` newlines before it.
struct bssh_frame_repaint {
	bssh_varint  offset;
	bssh_varint  lines;
	u8           last [max = 1];
}

// Not a frame: a datagram of the reliable stream the frames above travel in
// where the transport carries each datagram once and promises nothing more --
// fuzznet's say and heard (sec 5.6), which leave resending to the caller.
// `offset` is where the data that follows begins in its sender's stream;
// `ack` says every byte of the other stream before it has arrived; `window`
// is how far past `ack` the other side may send. The rest is data, perhaps
// none, which is an acknowledgement alone.
struct bssh_segment {
	bssh_varint  offset;
	bssh_varint  ack;
	bssh_varint  window;
}
