#!/usr/bin/make -f
#
# The version comes from the VERSION file at the root, not from here and
# not from debian/changelog; `make version-check` gates the three against
# each other. dh_shlibdeps computes Depends from the linked binary, which
# is why no dependency list is written by hand: one that is maintained by
# hand is one that drifts every time a library is linked or dropped.

%:
	dh $@

# Every tree the packages are built in, under the package build's own
# (DEB_BUILD_DIR, from `make deb`), with the programs and their pages
# beside them: a package build and a plain one never rebuild each other's
# objects, and `make deb` twice compiles nothing the second time. Handed
# over in the environment, not on make's command line, where a variable
# would reach every sub-make -- fuzznet's and the ones qmake writes -- as
# an override of their own assignments. PREFIX in the build as in the
# install, so the two see one configuration.
DEB_BUILD_DIR ?= build-deb
BUILD_ENV = BUILD_DIR=$(DEB_BUILD_DIR)/app SSHD_BUILD_DIR=$(DEB_BUILD_DIR)/sshd \
            VTERM_BUILD_DIR=$(DEB_BUILD_DIR)/vterm LIBSSH_BUILD_DIR=$(DEB_BUILD_DIR)/libssh \
            FUZZNET_BUILD_DIR=$(DEB_BUILD_DIR)/fuzznet ARTIFACT_DIR=$(DEB_BUILD_DIR) \
            PREFIX=/usr

# Debian's flags are ADDED to the project's, and the Makefile hands them
# to qmake, cmake and its own compiles with -O filtered out. fuzznet reads
# CFLAGS itself, so -Os comes back for it here, the last -O winning.
export DEB_CFLAGS_MAINT_APPEND = -Os
export DEB_CXXFLAGS_MAINT_APPEND = -Os

# The programs, their pages and the session helper, so that the install
# step builds nothing.
override_dh_auto_build:
	$(BUILD_ENV) $(MAKE) all doc session

# The suite is NOT run while packaging, and this line is what stops it.
#
# dh_auto_test runs `make test` whenever a test target exists, so a plain
# `%: dh $@` rules file quietly made `make deb` build and run all 516
# cases -- most of them Qt widget tests that want a display. That fails in
# a build chroot for a reason that has nothing to do with packaging, and
# it fails on a developer machine too when anything else is building,
# since two `make test` runs share build-tests.
#
# Nothing is lost by skipping it. `make test` and `make check-ci` are what
# gate this project, they run before every push, and check-ci builds in
# the runner's own image -- a stricter environment than dpkg-buildpackage
# provides. Running the suite again here would be a second copy of a check
# that already passed, taking the package build down with it when it
# collided.
#
# To have it back, delete this override and give the suite a display:
# `export QT_QPA_PLATFORM=offscreen` in a dh_auto_test override. That is a
# deliberate trade of package build time for a check already made, not a
# default worth having.
override_dh_auto_test:

# Clean with deb-clean, not the distclean debhelper picks by default:
# distclean is veryclean, which removes the Android build too, so building
# the desktop package deleted the APK (holder, 2026-10-29). deb-clean
# removes the package build's tree and nothing else. `make deb` passes -nc
# and does not clean; this is for dpkg-buildpackage run directly.
override_dh_auto_clean:
	DEB_BUILD_DIR=$(DEB_BUILD_DIR) $(MAKE) deb-clean

override_dh_auto_install:
	$(BUILD_ENV) $(MAKE) install DESTDIR=$(CURDIR)/debian/tmp

# beersshd's root fuzznet daemon (project.md sec 5.6) is shipped and left
# off: debhelper enables and starts every unit it finds unless told, and a
# root daemon on a UDP port is the administrator's to turn on. The unit
# also waits for its map of devices to users, which nothing installs.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

# And the per-user one: enabled, it would start for every user who logs in,
# each serving fuzznet on beersshd's port. Each user turns on their own.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable
